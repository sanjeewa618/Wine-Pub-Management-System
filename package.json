{
  "name": "wine-pub-management-system",
  "version": "1.0.0",
  "description": "Wine Pub Management System — monorepo root",
  "private": true,
  "scripts": {
    "install:backend": "npm install --prefix backend",
    "install:frontend": "npm install --prefix frontend/src",
    "install:all": "npm run install:backend && npm run install:frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend/src",
    "start:backend": "npm run start --prefix backend",
    "start:frontend": "npm run start --prefix frontend/src",
    "build:frontend": "npm run build --prefix frontend/src",
    "seed": "npm run seed --prefix backend"
  }
}

